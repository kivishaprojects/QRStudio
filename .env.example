NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imp6c2lxYnZyZGhlYWV3eHh3bG1rIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODQ3MDI0MTQsImV4cCI6MjEwMDI3ODQxNH0.4r9nwRkS2oLCoEHDwEt2sAe0aZ8jJhUJ66M1xWbk0p4

# ---- App base URL (used for dynamic-QR redirect links & payment return URL) ----
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ---- Cashfree payments ----
# Public: which Cashfree environment the browser SDK uses ("sandbox" or "production")
NEXT_PUBLIC_CASHFREE_MODE=sandbox
# SECRET (server-only) — never expose these in the browser:
CASHFREE_ENV=sandbox
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key

# ---- GSTIN auto-fetch (optional; Cashfree Verification Suite) ----
# Enable "Verification Suite" in the Cashfree dashboard and paste its API
# credentials here. If left unset, checkout falls back to state-only detection
# (customer types city + pincode). These are SEPARATE from the payment keys above.
CASHFREE_VERIFY_ENV=sandbox
CASHFREE_VERIFY_CLIENT_ID=your_cashfree_verification_client_id
CASHFREE_VERIFY_CLIENT_SECRET=your_cashfree_verification_client_secret

# SECRET (server-only) — Supabase service role key, used only to grant credits AFTER
# Cashfree confirms a payment. Get it from Supabase → Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ---- Emailed receipts (optional; Resend) ----
RESEND_API_KEY=your_resend_api_key
RESEND_FROM=QR Studio <receipts@your-domain.com>
